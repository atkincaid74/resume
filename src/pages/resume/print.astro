---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resume } from "../../content/resume";
---

<BaseLayout
  title={`${resume.name} — Resume`}
  description={`${resume.name} · ${resume.positioning}`}
  path="/resume/print"
  noIndex
>
  <article class="doc">
    <header class="doc__header">
      <div class="doc__ident">
        <h1 class="doc__name">{resume.name}</h1>
        <p class="doc__positioning">{resume.positioning}</p>
      </div>
      <div class="doc__contact">
        <p>{resume.location}</p>
        <p>
          <a href={`mailto:${resume.email}`}>{resume.email}</a>
        </p>
        <p>
          <a href={resume.links.site.href}>{resume.links.site.label}</a>
          <span class="sep">·</span>
          <a href={resume.links.linkedin.href}>LinkedIn</a>
          <span class="sep">·</span>
          <a href={resume.links.github.href}>GitHub</a>
        </p>
      </div>
    </header>

    <hr class="doc__rule" />

    <section class="doc__summary">
      <p>{resume.summary}</p>
    </section>

    <section class="doc__section">
      <h2 class="doc__h">Experience</h2>
      <ol class="doc__roles">
        {resume.experience.map((role) => (
          <li class="doc__role">
            <header class="doc__role-header">
              <div class="doc__role-left">
                <p class="doc__role-title">
                  <strong>{role.title}</strong>
                  <span class="doc__role-sep">·</span>
                  <span class="doc__role-company">{role.company}</span>
                </p>
              </div>
              <div class="doc__role-right">
                <span class="doc__role-dates">{role.start} – {role.end}</span>
              </div>
            </header>
            {role.summary && <p class="doc__role-summary">{role.summary}</p>}
            <ul class="doc__bullets">
              {role.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="doc__section doc__section--split">
      <div>
        <h2 class="doc__h">Focus areas</h2>
        <dl class="doc__skills">
          {resume.skills.map((group) => (
            <>
              <dt>{group.label}</dt>
              <dd>{group.items.join(" · ")}</dd>
            </>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="doc__h">Education</h2>
        <p class="doc__edu">
          <strong>{resume.education.school}</strong><br />
          {resume.education.degree}
          {resume.education.detail && <><br /><em>{resume.education.detail}</em></>}
        </p>
        <h2 class="doc__h doc__h--mt">Credentials</h2>
        <ul class="doc__creds">
          {resume.credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <footer class="doc__foot">
      <span>{resume.links.site.label}</span>
      <span class="sep">·</span>
      <span>{resume.links.ambr.label}</span>
      <span class="sep">·</span>
      <span>{resume.email}</span>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  @page {
    size: Letter;
    margin: 0.5in 0.55in;
  }

  html,
  body {
    background: #ffffff !important;
  }

  body {
    color: #15140f;
    font-family: var(--f-body);
    font-size: 10.2pt;
    line-height: 1.42;
  }

  /* Suppress nav/footer chrome from other layouts if it leaks in */
  header.masthead,
  footer.footer {
    display: none !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .doc {
    max-width: 100%;
    padding: 0;
    background: #ffffff;
  }

  .doc__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem;
    padding-bottom: 0.6rem;
  }
  .doc__name {
    font-family: var(--f-display);
    font-size: 34pt;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: #15140f;
  }
  .doc__positioning {
    font-family: var(--f-body);
    font-size: 10.5pt;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2f4a3a;
    margin-top: 0.35rem;
    font-weight: 600;
  }
  .doc__contact {
    text-align: right;
    font-size: 8.8pt;
    color: #3a3833;
    line-height: 1.45;
  }
  .doc__contact .sep {
    margin: 0 0.3rem;
    color: #8a847a;
  }

  .doc__rule {
    border-top: 1.5px solid #2f4a3a;
    margin: 0.35rem 0 0.75rem;
  }

  .doc__summary {
    font-family: var(--f-display);
    font-size: 11.5pt;
    line-height: 1.4;
    color: #2a2925;
    margin-bottom: 0.9rem;
  }

  .doc__section {
    margin-top: 0.7rem;
  }
  .doc__section--split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.5rem;
    margin-top: 0.9rem;
  }

  .doc__h {
    font-family: var(--f-body);
    font-size: 9pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #2f4a3a;
    font-weight: 700;
    padding-bottom: 0.25rem;
    margin-bottom: 0.55rem;
    border-bottom: 0.5px solid #cfc6b4;
  }
  .doc__h--mt {
    margin-top: 0.9rem;
  }

  .doc__roles {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
    margin: 0;
  }
  .doc__role {
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .doc__role-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.2rem;
  }
  .doc__role-title {
    font-size: 10.5pt;
    color: #15140f;
  }
  .doc__role-title strong {
    font-weight: 600;
  }
  .doc__role-sep {
    color: #8a847a;
    margin: 0 0.35rem;
  }
  .doc__role-company {
    color: #2f4a3a;
    font-weight: 500;
  }
  .doc__role-dates {
    font-size: 8.8pt;
    color: #5e5a54;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .doc__role-summary {
    font-size: 9.8pt;
    color: #3a3833;
    margin: 0.15rem 0 0.25rem;
    line-height: 1.4;
    font-style: italic;
  }
  .doc__bullets {
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }
  .doc__bullets li {
    position: relative;
    padding-left: 0.85rem;
    font-size: 9.8pt;
    line-height: 1.42;
    color: #1f1e1a;
    break-inside: avoid;
  }
  .doc__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 5px;
    height: 1px;
    background: #2f4a3a;
  }

  .doc__skills {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.8rem;
    row-gap: 0.3rem;
    font-size: 9.6pt;
  }
  .doc__skills dt {
    font-weight: 600;
    color: #2f4a3a;
    letter-spacing: 0.04em;
  }
  .doc__skills dd {
    margin: 0;
    color: #1f1e1a;
    line-height: 1.45;
  }

  .doc__edu {
    font-size: 9.8pt;
    line-height: 1.45;
    color: #1f1e1a;
  }
  .doc__edu strong {
    font-weight: 600;
  }
  .doc__edu em {
    color: #5e5a54;
    font-style: italic;
  }

  .doc__creds {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
  }
  .doc__creds li {
    position: relative;
    padding-left: 0.8rem;
    font-size: 9.6pt;
    color: #1f1e1a;
  }
  .doc__creds li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 1px;
    background: #2f4a3a;
  }

  .doc__foot {
    margin-top: 1rem;
    padding-top: 0.4rem;
    border-top: 0.5px solid #cfc6b4;
    font-size: 8.2pt;
    color: #5e5a54;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .doc__foot .sep {
    margin: 0 0.45rem;
    color: #8a847a;
  }
</style>
