---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resume } from "../../content/resume";

const companySpan = (group: (typeof resume.experience)[number]) => {
  const first = group.roles[0];
  const last = group.roles[group.roles.length - 1];
  return `${last.start} – ${first.end}`;
};
---

<BaseLayout
  title={`${resume.name} — Resume`}
  description={`${resume.name} · ${resume.positioning}`}
  path="/resume/print"
  noIndex
>
  <article class="doc">
    <header class="doc__header">
      <div class="doc__ident">
        <h1 class="doc__name">{resume.name}</h1>
        <p class="doc__positioning">{resume.positioning}</p>
      </div>
      <div class="doc__contact">
        <p>{resume.location}</p>
        <p>
          <a href={`mailto:${resume.email}`}>{resume.email}</a>
        </p>
        <p>
          <a href={resume.links.site.href}>{resume.links.site.label}</a>
          <span class="sep">·</span>
          <a href={resume.links.linkedin.href}>LinkedIn</a>
          <span class="sep">·</span>
          <a href={resume.links.github.href}>GitHub</a>
        </p>
      </div>
    </header>

    <hr class="doc__rule" />

    <section class="doc__summary">
      <p>{resume.summary}</p>
    </section>

    <section class="doc__section">
      <h2 class="doc__h">Experience</h2>
      <ol class="doc__companies">
        {resume.experience.map((group) => (
          <li class="doc__company">
            <header class="doc__company-header">
              <span class="doc__company-name">{group.company}</span>
              <span class="doc__company-span">{companySpan(group)}</span>
            </header>
            <ol class="doc__roles">
              {group.roles.map((role) => (
                <li class="doc__role">
                  <header class="doc__role-header">
                    <p class="doc__role-title">
                      <strong>{role.title}</strong>
                    </p>
                    <span class="doc__role-dates">{role.start} – {role.end}</span>
                  </header>
                  {role.summary && <p class="doc__role-summary">{role.summary}</p>}
                  <ul class="doc__bullets">
                    {role.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </section>

    <section class="doc__section doc__section--split">
      <div>
        <h2 class="doc__h">Focus areas</h2>
        <dl class="doc__skills">
          {resume.skills.map((group) => (
            <>
              <dt>{group.label}</dt>
              <dd>{group.items.join(" · ")}</dd>
            </>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="doc__h">Education</h2>
        <p class="doc__edu">
          <strong>{resume.education.school}</strong><br />
          {resume.education.degree}
          {resume.education.detail && <><br /><em>{resume.education.detail}</em></>}
        </p>
        <h2 class="doc__h doc__h--mt">Credentials</h2>
        <ul class="doc__creds">
          {resume.credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <footer class="doc__foot">
      <span>{resume.links.site.label}</span>
      <span class="sep">·</span>
      <span>{resume.links.ambr.label}</span>
      <span class="sep">·</span>
      <span>{resume.email}</span>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  @page {
    size: Letter;
    margin: 0.5in 0.55in;
  }

  html,
  body {
    background: #ffffff !important;
  }

  body {
    color: #15140f;
    font-family: var(--f-body);
    font-size: 9.8pt;
    line-height: 1.38;
  }

  /* Suppress nav/footer chrome from other layouts if it leaks in */
  header.masthead,
  footer.footer {
    display: none !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .doc {
    max-width: 100%;
    padding: 0;
    background: #ffffff;
  }

  .doc__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem;
    padding-bottom: 0.6rem;
  }
  .doc__name {
    font-family: var(--f-display);
    font-size: 34pt;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: #15140f;
  }
  .doc__positioning {
    font-family: var(--f-body);
    font-size: 10.5pt;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2f4a3a;
    margin-top: 0.35rem;
    font-weight: 600;
  }
  .doc__contact {
    text-align: right;
    font-size: 8.8pt;
    color: #3a3833;
    line-height: 1.45;
  }
  .doc__contact .sep {
    margin: 0 0.3rem;
    color: #8a847a;
  }

  .doc__rule {
    border-top: 1.5px solid #2f4a3a;
    margin: 0.35rem 0 0.75rem;
  }

  .doc__summary {
    font-family: var(--f-display);
    font-size: 11pt;
    line-height: 1.38;
    color: #2a2925;
    margin-bottom: 0.6rem;
  }

  .doc__section {
    margin-top: 0.55rem;
  }
  .doc__section--split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.3rem;
    margin-top: 0.7rem;
  }

  .doc__h {
    font-family: var(--f-body);
    font-size: 9pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #2f4a3a;
    font-weight: 700;
    padding-bottom: 0.25rem;
    margin-bottom: 0.55rem;
    border-bottom: 0.5px solid #cfc6b4;
  }
  .doc__h--mt {
    margin-top: 0.9rem;
  }

  .doc__companies {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
    margin: 0;
  }
  .doc__company {
    break-inside: avoid-page;
    page-break-inside: avoid;
  }
  .doc__company-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding-bottom: 0.1rem;
    margin-bottom: 0.3rem;
    border-bottom: 0.5px solid #e0d9c8;
    /* Keep the header with at least its first role */
    break-after: avoid;
    page-break-after: avoid;
  }
  .doc__company-name {
    font-family: var(--f-display);
    font-size: 13pt;
    line-height: 1;
    color: #15140f;
    letter-spacing: -0.01em;
  }
  .doc__company-span {
    font-size: 8.6pt;
    color: #5e5a54;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .doc__roles {
    display: grid;
    gap: 0.35rem;
    padding: 0 0 0 0.65rem;
    list-style: none;
    margin: 0 0 0 0.05rem;
    border-left: 0.5px solid #d6ccb4;
  }
  .doc__role {
    break-inside: avoid;
    page-break-inside: avoid;
    position: relative;
  }
  .doc__role::before {
    content: "";
    position: absolute;
    left: calc(-0.65rem - 2.5px);
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2f4a3a;
    box-shadow: 0 0 0 2.5px #ffffff;
  }
  .doc__role-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.15rem;
  }
  .doc__role-title {
    font-size: 10pt;
    color: #15140f;
  }
  .doc__role-title strong {
    font-weight: 600;
  }
  .doc__role-dates {
    font-size: 8.6pt;
    color: #5e5a54;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .doc__role-summary {
    font-size: 9.4pt;
    color: #3a3833;
    margin: 0.1rem 0 0.2rem;
    line-height: 1.38;
    font-style: italic;
  }
  .doc__bullets {
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.08rem;
  }
  .doc__bullets li {
    position: relative;
    padding-left: 0.8rem;
    font-size: 9.3pt;
    line-height: 1.38;
    color: #1f1e1a;
    break-inside: avoid;
  }
  .doc__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 5px;
    height: 1px;
    background: #2f4a3a;
  }

  .doc__skills {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.8rem;
    row-gap: 0.3rem;
    font-size: 9.6pt;
  }
  .doc__skills dt {
    font-weight: 600;
    color: #2f4a3a;
    letter-spacing: 0.04em;
  }
  .doc__skills dd {
    margin: 0;
    color: #1f1e1a;
    line-height: 1.45;
  }

  .doc__edu {
    font-size: 9.8pt;
    line-height: 1.45;
    color: #1f1e1a;
  }
  .doc__edu strong {
    font-weight: 600;
  }
  .doc__edu em {
    color: #5e5a54;
    font-style: italic;
  }

  .doc__creds {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
  }
  .doc__creds li {
    position: relative;
    padding-left: 0.8rem;
    font-size: 9.6pt;
    color: #1f1e1a;
  }
  .doc__creds li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 1px;
    background: #2f4a3a;
  }

  .doc__foot {
    margin-top: 1rem;
    padding-top: 0.4rem;
    border-top: 0.5px solid #cfc6b4;
    font-size: 8.2pt;
    color: #5e5a54;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .doc__foot .sep {
    margin: 0 0.45rem;
    color: #8a847a;
  }
</style>
