---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resume } from "../content/resume";
---

<BaseLayout>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="wrap masthead__inner">
      <a class="mark" href="/" aria-label={`${resume.name} — home`}>
        <span class="mark__glyph" aria-hidden="true">{resume.initials}</span>
        <span class="mark__rule" aria-hidden="true"></span>
        <span class="mark__label">{resume.name}</span>
      </a>
      <nav class="masthead__nav" aria-label="Primary">
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href={resume.pdfFile} class="btn btn--ghost" download>Download PDF</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero wrap">
      <p class="eyebrow">
        <span class="eyebrow__dot" aria-hidden="true"></span>
        {resume.positioning} &nbsp;·&nbsp; {resume.location}
      </p>
      <h1 class="hero__headline">
        <span>{resume.headline}</span>
      </h1>
      <div class="hero__actions">
        <a href={resume.pdfFile} class="btn btn--solid" download>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
          </svg>
          Download resume PDF
        </a>
        <a href={`mailto:${resume.email}`} class="btn btn--ghost">
          {resume.email}
        </a>
      </div>
    </section>

    <section class="summary wrap">
      <div class="summary__rule" aria-hidden="true"></div>
      <p class="summary__body">{resume.summary}</p>
    </section>

    <section class="highlights wrap" aria-labelledby="highlights-title">
      <h2 id="highlights-title" class="section__title">
        <span class="section__kicker">01</span> Selected strengths
      </h2>
      <ul class="highlights__grid">
        {resume.highlights.map((h) => (
          <li class="highlight">
            <h3 class="highlight__label">{h.label}</h3>
            <p class="highlight__body">{h.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="experience" class="experience wrap" aria-labelledby="experience-title">
      <h2 id="experience-title" class="section__title">
        <span class="section__kicker">02</span> Experience
      </h2>
      <ol class="roles">
        {resume.experience.map((role, i) => (
          <li class="role" data-index={String(i + 1).padStart(2, "0")}>
            <div class="role__meta">
              <span class="role__dates">{role.start} — {role.end}</span>
              <span class="role__company">{role.company}</span>
            </div>
            <div class="role__body">
              <h3 class="role__title">{role.title}</h3>
              {role.summary && <p class="role__summary">{role.summary}</p>}
              <ul class="role__bullets">
                {role.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills" class="skills wrap" aria-labelledby="skills-title">
      <h2 id="skills-title" class="section__title">
        <span class="section__kicker">03</span> Focus areas
      </h2>
      <div class="skills__grid">
        {resume.skills.map((group) => (
          <div class="skill-group">
            <h3 class="skill-group__label">{group.label}</h3>
            <ul class="skill-group__items">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="credentials wrap" aria-labelledby="cred-title">
      <h2 id="cred-title" class="section__title">
        <span class="section__kicker">04</span> Education & credentials
      </h2>
      <div class="credentials__grid">
        <div>
          <h3 class="credentials__h">Education</h3>
          <p class="credentials__line"><strong>{resume.education.school}</strong></p>
          <p class="credentials__line">{resume.education.degree}</p>
          {resume.education.detail && (
            <p class="credentials__line credentials__detail">{resume.education.detail}</p>
          )}
        </div>
        <div>
          <h3 class="credentials__h">Credentials</h3>
          <ul class="credentials__list">
            {resume.credentials.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p class="footer__cta">
        Let's talk. <a href={`mailto:${resume.email}`}>{resume.email}</a>
      </p>
      <nav class="footer__links" aria-label="Elsewhere">
        <a href={resume.links.site.href} target="_blank" rel="noopener">
          {resume.links.site.label} <span aria-hidden="true">↗</span>
        </a>
        <a href={resume.links.ambr.href} target="_blank" rel="noopener">
          {resume.links.ambr.label} <span aria-hidden="true">↗</span>
        </a>
        <a href={resume.links.linkedin.href} target="_blank" rel="noopener">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={resume.links.github.href} target="_blank" rel="noopener">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <p class="footer__meta">
        © {new Date().getFullYear()} {resume.name}. Built with Astro. Deployed on Firebase Hosting.
      </p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ------- layout primitives ------- */
  .wrap {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--page-pad);
  }
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--c-ink);
    color: var(--c-bg);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }

  /* ------- masthead ------- */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-ink);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .mark__glyph {
    font-family: var(--f-display);
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-accent);
    font-feature-settings: "salt";
  }
  .mark__rule {
    width: 22px;
    height: 1px;
    background: var(--c-rule);
  }
  .mark__label {
    font-weight: 500;
  }
  .masthead__nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.88rem;
  }
  .masthead__nav a {
    color: var(--c-ink-soft);
  }
  .masthead__nav a:hover {
    color: var(--c-accent);
  }
  @media (max-width: 560px) {
    .masthead__nav > a:not(.btn) {
      display: none;
    }
  }

  /* ------- buttons ------- */
  .btn {
    --pad-y: 0.7rem;
    --pad-x: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: var(--pad-y) var(--pad-x);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    transition: transform 0.16s var(--ease), background 0.18s var(--ease),
      color 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .btn--solid {
    background: var(--c-accent);
    color: var(--c-bg);
    border: 1px solid var(--c-accent);
  }
  .btn--solid:hover {
    background: var(--c-accent-deep);
    border-color: var(--c-accent-deep);
    transform: translateY(-1px);
  }
  .btn--ghost {
    background: transparent;
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
  }
  .btn--ghost:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  /* ------- hero ------- */
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.8rem;
  }
  .eyebrow__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c-accent) 18%, transparent);
  }
  .hero__headline {
    font-family: var(--f-display);
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 18ch;
    color: var(--c-ink);
  }
  .hero__headline span {
    background-image: linear-gradient(
      180deg,
      var(--c-ink) 0 72%,
      var(--c-accent) 72% 100%
    );
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.2rem;
  }

  /* ------- summary ------- */
  .summary {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid var(--c-rule);
  }
  .summary__rule {
    width: 1px;
    background: var(--c-accent);
  }
  .summary__body {
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.35;
    color: var(--c-ink-soft);
    max-width: 58ch;
  }

  /* ------- section shell ------- */
  .section__title {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .section__kicker {
    font-family: var(--f-body);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--c-muted-2);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  main > section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--c-rule);
  }
  main > section:first-of-type {
    border-top: 0;
  }

  /* ------- highlights ------- */
  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0;
  }
  .highlight {
    padding: 1.6rem 1.8rem 1.6rem 0;
    border-top: 1px solid var(--c-rule-soft);
    position: relative;
  }
  .highlight:first-child {
    border-top-color: var(--c-ink);
  }
  @media (min-width: 760px) {
    .highlights__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
    .highlight:nth-child(2) {
      border-top-color: var(--c-ink);
    }
    .highlight::before {
      content: "";
      position: absolute;
      left: -1.25rem;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--c-rule-soft);
    }
    .highlight:nth-child(odd)::before {
      display: none;
    }
  }
  .highlight__label {
    font-family: var(--f-body);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent);
    font-weight: 600;
    margin-bottom: 0.55rem;
  }
  .highlight__body {
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--c-ink-soft);
    max-width: 44ch;
  }

  /* ------- experience ------- */
  .roles {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .role {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-rule-soft);
    position: relative;
  }
  .role::before {
    content: attr(data-index);
    position: absolute;
    top: 1.55rem;
    right: 0;
    font-family: var(--f-body);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--c-muted-2);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 820px) {
    .role {
      grid-template-columns: 200px 1fr;
      column-gap: 3rem;
    }
    .role::before {
      top: 1.55rem;
    }
  }
  .role__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.15rem;
  }
  .role__dates {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
  .role__company {
    font-family: var(--f-display);
    font-size: 1.25rem;
    line-height: 1.15;
    color: var(--c-ink);
  }
  .role__title {
    font-family: var(--f-body);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--c-ink);
    margin-bottom: 0.4rem;
  }
  .role__summary {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--c-ink-soft);
    margin-bottom: 0.8rem;
    max-width: 70ch;
  }
  .role__bullets {
    display: grid;
    gap: 0.55rem;
    padding-left: 0;
  }
  .role__bullets li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.99rem;
    line-height: 1.55;
    color: var(--c-ink-soft);
    max-width: 70ch;
  }
  .role__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 8px;
    height: 1px;
    background: var(--c-accent);
  }

  /* ------- skills ------- */
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .skill-group__label {
    font-family: var(--f-body);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent);
    font-weight: 600;
    margin-bottom: 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-rule);
  }
  .skill-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skill-group__items li {
    font-size: 0.88rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--c-rule);
    border-radius: 999px;
    color: var(--c-ink-soft);
    background: var(--c-bg-elev);
  }

  /* ------- credentials ------- */
  .credentials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
  }
  @media (min-width: 720px) {
    .credentials__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 4vw, 3rem);
    }
  }
  .credentials__h {
    font-family: var(--f-body);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }
  .credentials__line {
    font-size: 1rem;
    color: var(--c-ink-soft);
    line-height: 1.5;
  }
  .credentials__line strong {
    color: var(--c-ink);
    font-weight: 600;
  }
  .credentials__detail {
    color: var(--c-muted);
    font-style: italic;
  }
  .credentials__list {
    display: grid;
    gap: 0.35rem;
  }
  .credentials__list li {
    font-size: 1rem;
    color: var(--c-ink-soft);
    line-height: 1.5;
    padding-left: 1.1rem;
    position: relative;
  }
  .credentials__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 1px;
    background: var(--c-accent);
  }

  /* ------- footer ------- */
  .footer {
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--c-rule);
    background: var(--c-bg-elev);
  }
  .footer__inner {
    display: grid;
    gap: 1.2rem;
  }
  .footer__cta {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
    color: var(--c-ink);
  }
  .footer__cta a {
    color: var(--c-accent);
    border-bottom: 1px solid color-mix(in srgb, var(--c-accent) 40%, transparent);
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .footer__cta a:hover {
    color: var(--c-accent-deep);
    border-bottom-color: var(--c-accent-deep);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    font-size: 0.92rem;
    color: var(--c-ink-soft);
    padding-block: 0.8rem;
    border-top: 1px solid var(--c-rule-soft);
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .footer__links a:hover {
    color: var(--c-accent);
  }
  .footer__meta {
    font-size: 0.8rem;
    color: var(--c-muted-2);
    letter-spacing: 0.02em;
  }
</style>
